# Copy this file to `.env` (or `.env.local`) for local development, and set
# each variable in Railway (Project → Variables) for production. Never commit
# the real `.env`.

# ---------------------------------------------------------------------------
# Neon Postgres — backend persistence layer.
# Get from neon.tech → Project → Connection Details.
# ---------------------------------------------------------------------------
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/tbdetect?sslmode=require

# ---------------------------------------------------------------------------
# Backend runtime settings.
# ---------------------------------------------------------------------------
# Directory containing densenet121_best.pt / hybrid_best.pt inside the container.
MODEL_DIR=/app/models
# densenet121 (faster) or hybrid (novelty).
DEFAULT_MODEL=densenet121

# ---------------------------------------------------------------------------
# Frontend (local dev only).
# ---------------------------------------------------------------------------
# In production the frontend is served from the same origin as the API, so
# calls use relative /api/* paths. For local `npm run dev`, point this at the
# locally-running FastAPI:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Injected automatically by Railway — do not set manually.
# ---------------------------------------------------------------------------
# PORT=
