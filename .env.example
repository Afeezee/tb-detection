# Copy this file to `.env` for local development, and set each variable in
# Railway (Project → Variables) for production. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Neon Postgres — backend persistence layer.
# Get from neon.tech → Project → Connection Details.
# ---------------------------------------------------------------------------
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/tbdetect?sslmode=require

# ---------------------------------------------------------------------------
# Backend runtime settings.
# ---------------------------------------------------------------------------
# Directory containing densenet121_best.pt / hybrid_best.pt inside the container.
MODEL_DIR=./models
# densenet121 (faster) or hybrid (novelty).
DEFAULT_MODEL=densenet121
# Public URL of the frontend Railway service. Set this after the first frontend
# deploy so the backend's CORS allow-list matches. Comma-separated for multiple.
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Frontend build-time settings.
# ---------------------------------------------------------------------------
# Public URL of the backend Railway service — baked into the Next.js bundle at
# `next build`, so this must be set on the frontend service before deployment.
NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Injected automatically by Railway — do not set manually.
# ---------------------------------------------------------------------------
# PORT=
